<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView style="@style/Label" android:text="Stop after (min, 0 = never)" />

        <EditText
            android:id="@+id/max_minutes"
            style="@style/Field"
            android:inputType="number" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView style="@style/Label" android:text="Random extra pause" />

        <EditText
            android:id="@+id/loop_jitter"
            style="@style/Field"
            android:hint="up to ms"
            android:inputType="number" />
    </LinearLayout>
</LinearLayout>
