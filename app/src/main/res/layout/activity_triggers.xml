<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Triggers"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="other ways to start and stop the active macro"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Start"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/cd_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/cd_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3-2-1 on the panel before the first tap, Stop cancels it"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/line" />

            <Switch
                android:id="@+id/sched_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start at a set time"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/sched_macro"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/sched_time"
                    style="@style/Btn" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/sched_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Every day"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sched_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/line" />

            <Switch
                android:id="@+id/dyn_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Macros in the app icon menu"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="long press the TapLoop icon to play one of your latest macros"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/pin"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="Pin a macro to the home screen" />

            <Button
                android:id="@+id/add_tile"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="Add quick settings tile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="the tile shows or hides the floating panel"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="Stop"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/vol_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volume down stops playback"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="only while a macro is playing, volume works normally otherwise"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Switch
                android:id="@+id/screen_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Stop when the screen turns off"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/limit_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Time limit"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView style="@style/Label" android:text="Stop after (minutes)" />

            <EditText
                android:id="@+id/limit_min"
                style="@style/Field"
                android:hint="minutes"
                android:importantForAutofill="no"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="to stop after a number of runs, set Loops in the macro editor"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
