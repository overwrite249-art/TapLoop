<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TapLoop"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settings_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="record taps, tweak timings, loop them"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/acc_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/acc_btn"
                style="@style/Btn"
                android:text="Enable" />
        </LinearLayout>

        <TextView
            android:id="@+id/acc_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Greyed out? Open App info → ⋮ menu → Allow restricted settings, then try again."
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen capture"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/cap_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="needed for color / image checks"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/cap_btn"
                style="@style/Btn"
                android:text="Start" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/panel_btn"
        style="@style/Btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_accent"
        android:text="Show floating panel"
        android:textColor="#0F1115"
        android:textStyle="bold" />

    <Button
        android:id="@+id/triggers_btn"
        style="@style/Btn"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="Triggers: countdown, schedule, shortcuts, auto stop" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="6dp"
        android:text="Macros"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <include layout="@layout/macro_tools" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No macros yet.\nOpen the panel and hit Rec."
        android:textColor="@color/muted"
        android:visibility="gone" />
</LinearLayout>
