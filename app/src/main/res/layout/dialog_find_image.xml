<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Image to find"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tpl_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/Label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="How close it has to match" />

            <TextView
                android:id="@+id/match_val"
                style="@style/Label"
                android:textColor="@color/text" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/match"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:max="49" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Label" android:text="Tap offset X (px)" />

                <EditText android:id="@+id/off_x" style="@style/Field" android:inputType="numberSigned" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Label" android:text="Tap offset Y (px)" />

                <EditText android:id="@+id/off_y" style="@style/Field" android:inputType="numberSigned" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Label" android:text="Wait before (ms)" />

                <EditText android:id="@+id/delay" style="@style/Field" android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Label" android:text="Press time (ms)" />

                <EditText android:id="@+id/duration" style="@style/Field" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Label" android:text="Keep looking for (ms)" />

        <EditText android:id="@+id/timeout" style="@style/Field" android:inputType="number" />

        <TextView style="@style/Label" android:text="If it's not found" />

        <Spinner
            android:id="@+id/miss"
            android:layout_width="match_parent"
            android:layout_height="44dp" />
    </LinearLayout>
</ScrollView>
